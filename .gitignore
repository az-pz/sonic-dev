# temp / scratch scripts (leading underscore convention used during dev)
_*.sh
_*.py
# ...but never ignore package __init__.py (the `_*.py` glob catches it)
!**/__init__.py

# emulator bundle build artifacts (regenerated by emu-deploy/build_bundle.sh)
emu-deploy/staging/
emu-deploy/*.tar.gz
# python
__pycache__/
*.pyc
.pytest_cache/
htmlcov/
.coverage
coverage.xml
test-results.xml

# os
.DS_Store
Thumbs.db


/presentation/*